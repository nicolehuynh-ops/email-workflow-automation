# Hiive AI Gateway — never commit the corresponding .env file.
AI_GATEWAY_BASE_URL=https://ai-gateway.hiive.network/compat
AI_GATEWAY_MODEL=openai/gpt-5.6-luna

# Larger inbox protection. Eligible Front messages are grouped into one model
# completion per batch. Transient failures use Retry-After or exponential backoff.
AI_GATEWAY_BATCH_SIZE=10
AI_GATEWAY_BATCH_PAUSE_SECONDS=1
AI_GATEWAY_MAX_ATTEMPTS=3
AI_GATEWAY_RETRY_BASE_SECONDS=1
AI_GATEWAY_RETRY_MAX_SECONDS=30

# Local developer access: run `cloudflared access login https://ai-gateway.hiive.network`,
# then set this to the output of `cloudflared access token -app=https://ai-gateway.hiive.network`.
CF_ACCESS_TOKEN=

# Automated container/scheduled access: provide both service-token values instead.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Live read-only source synchronization.
REPLY_IO_API_KEY=
FRONT_API_TOKEN=
CALENDLY_ACCESS_TOKEN=
CALENDLY_ORGANIZATION_URI=
